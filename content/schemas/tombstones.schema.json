{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "schemaVersion": {
      "const": 1
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]{0,79}$"
      },
      "maxItems": 5000
    }
  },
  "required": [
    "schemaVersion",
    "ids"
  ],
  "additionalProperties": false
}
